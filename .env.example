# ====================== MẪU BIẾN MÔI TRƯỜNG (chép thành .env) ======================
# KHÔNG commit file .env. Mọi biến bên dưới được đối chiếu trực tiếp với code
# trong src/server/ (README mục 5) — không có biến chết.

# --- Máy chủ Web (npm run web) ---
PORT=8787
WEB_BIND_HOST=127.0.0.1
WEB_ALLOW_PUBLIC=0
WEB_ALLOWED_ORIGIN=
WEB_ALLOWED_HOSTS=
WEB_TELEGRAM_POLLING=1
SESSION_TTL_HOURS=72
PREFERRED_PANCAKE_URL=https://pages.fm/
# Sau reverse proxy (Caddy/Nginx): 1 = giới hạn đăng nhập theo IP thật trong X-Forwarded-For.
# Chỉ bật khi proxy đáng tin; bật sai thì IP có thể bị giả mạo. Mặc định 0.
TRUST_PROXY=0

# --- Đăng nhập Supabase (để trống = giữ đăng nhập pdb cổ điển) ---
# Khi đủ cả 2 biến, lần đăng nhập ĐẦU TIÊN yêu cầu pdb + tài khoản Supabase
# (bind owner); sau đó pdb ngừng hoạt động và mọi phiên đăng nhập chỉ cần
# Supabase. Trạng thái ghi ở server/data/supabase.json (đã gitignore).
WEB_SUPABASE_URL=https://<project-ref>.supabase.co
WEB_SUPABASE_ANON_KEY=
# Break-glass: đặt 1 để cho phép quay lại đăng nhập bằng WEB_ACCESS_TOKEN
# khi Supabase không dùng được (mặc định 0 — pdb đã chết sau bootstrap).
WEB_PDB_EMERGENCY=0

# --- Token bootstrap (chỉ dùng 1 lần duy nhất cho lần đăng nhập đầu) ---
WEB_ACCESS_TOKEN=

# --- AI (đi qua cấu hình Dashboard; env chỉ là fallback lúc khởi tạo) ---
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Fallback cũ: OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL vẫn được đọc
# khi các biến AI_* ở trên trống.

# --- TTS (tương tự: cấu hình qua Dashboard, env là fallback) ---
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=

# --- Telegram điều khiển từ xa ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
